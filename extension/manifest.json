{
  "manifest_version": 3,
  "name": "NewsNowNext — Market Wire",
  "short_name": "NewsNowNext",
  "version": "2.0.0",
  "description": "Every new tab becomes your NewsNowNext feed: US, UK, China, France, Switzerland and Middle East desks on one page, with search and filters.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://feeds.bbci.co.uk/*",
    "https://feeds.content.dowjones.io/*",
    "https://feeds.feedburner.com/*",
    "https://finance.yahoo.com/*",
    "https://news.google.com/*",
    "https://search.cnbc.com/*",
    "https://seekingalpha.com/*",
    "https://www.al-monitor.com/*",
    "https://www.aljazeera.com/*",
    "https://www.france24.com/*",
    "https://www.ft.com/*",
    "https://www.haaretz.com/*",
    "https://www.investing.com/*",
    "https://www.lemonde.fr/*",
    "https://www.project-syndicate.org/*",
    "https://www.scmp.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
